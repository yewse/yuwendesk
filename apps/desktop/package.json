{
  "name": "@yuwendesk/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "YuwenDesk 桌面应用（Electron 主/预加载/渲染进程）。G01 可安装骨架。",
  "author": "YuwenDesk",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test:unit": "vitest run",
    "build:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "build:win": "npm run build && electron-builder --win nsis --x64 --config electron-builder.yml"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "eslint": "8.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "vitest": "2.1.1"
  }
}
