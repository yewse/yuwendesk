{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservationOutcome",
  "$ref": "#/$defs/ObservationOutcome",
  "$defs": {
    "ObservationOutcome": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "type": "string",
          "enum": [
            "met_expectation",
            "needed_prompt",
            "clear_difficulty",
            "insufficient_evidence"
          ]
        }
      },
      "required": [
        "observation_id",
        "outcome"
      ],
      "additionalProperties": false
    }
  }
}
