{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuwendesk.local/contracts/AcceptanceRun.schema.json",
  "title": "AcceptanceRunV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sourceCommit", "repositoryDirty", "startedAt", "completedAt", "environment", "definitionSources", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^run-[0-9]{8}-[a-f0-9]{7}-[0-9]{2}$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "repositoryDirty": { "type": "boolean" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "arch", "node", "npm"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 }
      }
    },
    "definitionSources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 170,
      "maxItems": 170,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "status", "evidenceLevel", "command", "exitCode", "executedAt", "environment", "evidence", "artifactHashes", "blockerCode", "externalInputIds", "observedResult"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "evidenceLevel": { "type": ["string", "null"], "enum": ["engineering_automation", "developer_windows", "clean_windows_standard_user", "office_wps", "live_api_authorized", "privacy_authorized_material", "teacher_professional_review", null] },
        "command": { "type": ["string", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "executedAt": { "type": ["string", "null"], "format": "date-time" },
        "environment": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/fileEvidence" } },
        "artifactHashes": { "type": "array", "items": { "$ref": "#/$defs/fileEvidence" } },
        "blockerCode": { "type": ["string", "null"] },
        "externalInputIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EXT[0-9]{2}$" } },
        "observedResult": { "type": "string", "minLength": 1 }
      }
    }
  }
}
